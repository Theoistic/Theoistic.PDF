@page
@model IndexModel
@using Theoistic.PDF.Templates
@{
    ViewData["Title"] = "Home page";
}

<h1 class="display-4">Theoistic.PDF</h1>

<p>
    PDF generation with no bundled engine and no native binaries.
</p>

<h2 class="h4 mt-4">Invoice templates</h2>

<p class="text-muted">
    Built in managed code: no HTML and no browser, so these work on any host. Each fills the same
    <code>Invoice</code> model; the logo is a transparent PNG.
</p>

<table class="table table-sm w-auto">
    <thead>
        <tr>
            <th></th>
            @foreach (InvoiceDocumentKind kind in Enum.GetValues<InvoiceDocumentKind>())
            {
                <th>@kind</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (InvoiceTemplate template in InvoiceTemplate.All)
        {
            <tr>
                <th>@template.Name</th>
                @foreach (InvoiceDocumentKind kind in Enum.GetValues<InvoiceDocumentKind>())
                {
                    <td>
                        <a asp-page="Index" asp-page-handler="Invoice" asp-route-template="@template.Name" asp-route-kind="@kind" target="_blank">PDF</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<h2 class="h4 mt-4">HTML to PDF</h2>

@if (Model.Status.IsAvailable)
{
    <p class="text-success">Renderer: @Model.Status.Description</p>

    <p>
        <a class="btn btn-primary" asp-page="Index" asp-page-handler="Pdf" target="_blank">
            Generate the HTML invoice
        </a>
    </p>

    <p class="text-muted">
        A Mustache template rendered by <code>MustacheRenderer</code>, styled by
        <code>InjectCSS</code> (including a custom <code>@@font-face</code>), then converted by a
        browser with a header and footer using the <code>[page]</code> and <code>[topage]</code>
        placeholders.
    </p>
}
else
{
    <div class="alert alert-warning">
        <p><strong>No browser available, so HTML cannot be rendered here.</strong> The templates above still work.</p>
        <p>@Model.Status.Description</p>
        <p class="mb-0">
            Install Microsoft Edge, Google Chrome or Chromium, or configure
            <code>ExecutablePath</code> or <code>RemoteAddress</code> in
            <code>AddTheoisticPDF</code>.
        </p>
    </div>
}
