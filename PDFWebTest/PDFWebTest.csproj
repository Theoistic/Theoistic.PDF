<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Tracks the library's lowest target so the sample builds against what it references. -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Theoistic.PDFWebTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Theoistic.PDF\Theoistic.PDF.csproj" />
  </ItemGroup>

  <!--
    Templates are read through IWebHostEnvironment.ContentRootPath, which is the project
    directory while debugging and the publish directory afterwards, so they have to travel.
  -->
  <ItemGroup>
    <Content Include="Templates\**\*.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
